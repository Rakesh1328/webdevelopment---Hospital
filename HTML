
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>CareWell Hospital</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <!-- Emergency bar at the top -->
  <div class="emergency">
    Emergency? Call 108 or our 24/7 line: 0866-2345678
  </div>

  <header>
    <h2>CareWell Hospital</h2>
    <nav>
      <a href="#departments">Departments</a>
      <a href="#doctors">Doctors</a>
      <a href="#tips">Health Tips</a>
      <a href="#appointment">Appointment</a>
    </nav>
  </header>

  <section class="hero">
    <h1>Caring for you and your family</h1>
    <p>Trusted multi-speciality hospital with 24/7 care.</p>
    <a class="btn" href="#appointment">Book appointment</a>
  </section>

  <section id="departments">
    <h2>Our Departments</h2>
    <div class="cards">
      <div class="card">
        <h3>Cardiology</h3>
        <p>Heart care and checkups</p>
      </div>

      <div class="card">
        <h3>Orthopedics</h3>
        <p>Bones and joints</p>
      </div>

      <div class="card">
        <h3>Pediatrics</h3>
        <p>Child healthcare</p>
      </div>

      <div class="card">
        <h3>General Medicine</h3>
        <p>Fever, diabetes, BP</p>
      </div>
    </div>
  </section>

  <section id="doctors" class="alt">
    <h2>Our Doctors</h2>
    <div class="cards">
      <div class="card">
        <h3>Dr. Lakshmi Rao</h3>
        <p>Cardiologist, 15 yrs</p>
      </div>

      <div class="card">
        <h3>Dr. Suresh Kumar</h3>
        <p>Orthopedic Surgeon, 12 yrs</p>
      </div>

      <div class="card">
        <h3>Dr. Anitha Reddy</h3>
        <p>Pediatrician, 10 yrs</p>
      </div>
    </div>
  </section>

  <section id="tips">
    <h2>Health Tips</h2>
    <p>
      Drink 2 to 3 litres of water daily.
      Walk 30 minutes a day.
      Get a yearly health checkup.
    </p>
  </section>

  <!-- APPOINTMENT FORM -->
  <section id="appointment" class="alt">
    <h2>Book an Appointment</h2>

    <form>
      <input type="text" placeholder="Patient name" required>
      <input type="tel" placeholder="Phone number" required>

      <select>
        <option>Cardiology</option>
        <option>Orthopedics</option>
        <option>Pediatrics</option>
        <option>General Medicine</option>
      </select>

      <input type="date" required>

      <button type="submit">Confirm appointment</button>
    </form>
  </section>

  <footer>
    © 2026 CareWell Hospital | Benz Circle, Vijayawada |
    care@carewell.example
  </footer>

</body>
</html>
