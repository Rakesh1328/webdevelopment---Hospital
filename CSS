
/* Basic Reset */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    color: #222;
    line-height: 1.6;
}

/* Emergency Bar */
.emergency {
    background: #c62828;
    color: white;
    text-align: center;
    padding: 8px;
    font-weight: bold;
}

/* Header and Navigation */
header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 40px;
    background: white;
    border-bottom: 3px solid #0b7a75;
}

header h2 {
    color: #0b7a75;
}

nav a {
    color: #0b7a75;
    text-decoration: none;
    margin-left: 20px;
    font-weight: bold;
}

nav a:hover {
    text-decoration: underline;
}

/* Hero Section */
.hero {
    text-align: center;
    padding: 100px 20px;
    color: white;
    background: #0b7a75;
}

.hero h1 {
    font-size: 2.5rem;
    margin-bottom: 10px;
}

.btn {
    display: inline-block;
    margin-top: 20px;
    padding: 12px 28px;
    background: white;
    color: #0b7a75;
    text-decoration: none;
    font-weight: bold;
    border-radius: 4px;
}

/* Sections */
section {
    padding: 60px 40px;
    text-align: center;
}

section h2 {
    margin-bottom: 28px;
    color: #0b7a75;
}

.alt {
    background: #eaf5f4;
}

/* Cards - CSS Grid */
.cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
}

.card {
    background: white;
    padding: 24px;
    border-radius: 8px;
    border-left: 5px solid #0b7a75;
    text-align: left;
}

/* Appointment Form */
form {
    max-width: 420px;
    margin: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

input, select, button {
    padding: 10px;
    font-size: 1rem;
    width: 100%;
}

button {
    background: #0b7a75;
    color: white;
    border: none;
    cursor: pointer;
    border-radius: 4px;
}

button:hover {
    background: #07544f;
}

/* Footer */
footer {
    text-align: center;
    padding: 20px;
    background: #07544f;
    color: white;
}

/* Responsive Mobile Layout */
@media (max-width: 768px) {
    header {
        flex-direction: column;
        gap: 10px;
    }

    nav a {
        margin: 0 8px;
    }

    .hero h1 {
        font-size: 1.8rem;
    }

    section {
        padding: 40px 20px;
    }
}
